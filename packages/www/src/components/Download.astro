---
import { Picture } from "astro:assets";
import {
  DESKTOP_DOWNLOADS,
  DESKTOP_PLATFORMS,
  DESKTOP_PLATFORM_BUTTON_LABEL_KEYS,
  DESKTOP_PLATFORM_LABEL_KEYS,
  DESKTOP_RECOMMENDED_DOWNLOADS,
  getDesktopDownloadUrl,
} from "../../../util/shared/src/desktopDownloads";
import { getAppStoreBadgeUrl } from "../../../util/shared/src/getAppStoreBadgeUrl";
import { getGooglePlayBadgeUrl } from "../../../util/shared/src/getGooglePlayBadgeUrl";
import { MOBILE_APP_STORE_URLS } from "../../../util/shared/src/MOBILE_APP_STORE_URLS";
import DesktopPlatformIcon from "./DesktopPlatformIcon.astro";
import type { Translator } from "../i18n/translations";

const heroBg =
  "https://static.recipesage.com/assets/art/chicken-salad-2025-05-03.jpg";

interface Props {
  t: Translator;
  locale: string;
}

const { t, locale } = Astro.props;

const appStoreBadgeUrl = getAppStoreBadgeUrl(locale);
const googlePlayBadgeUrl = getGooglePlayBadgeUrl(locale);

const bookmarklet =
  "javascript:(function(){location.href='https://recipesage.com/app/edit-recipe/new?autofill-url='+encodeURIComponent(location.href);})();";
---

<section class="download-hero">
  <Picture
    src={heroBg}
    widths={[640, 1280, 1920]}
    sizes="100vw"
    formats={["avif", "webp"]}
    fallbackFormat="jpg"
    alt=""
    class="download-hero-bg"
    loading="eager"
    decoding="async"
    inferSize
  />
  <div class="download-hero-inner">
    <h1>{t("pages.downloadAndInstall.title")}</h1>
    <p class="lead">{t("pages.downloadAndInstall.subtitle")}</p>
  </div>
</section>

<article class="download-content">
  <div class="store-cards">
    <section class="platform store-card">
      <div class="platform-header">
        <span class="platform-icon" aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
            <path d="M12 18h.01"></path>
          </svg>
        </span>
        <h2>{t("pages.downloadAndInstall.ios.title")}</h2>
      </div>
      <p class="instruction-header">
        {t("pages.downloadAndInstall.ios.description")}
      </p>
      <a
        class="store-badge"
        href={MOBILE_APP_STORE_URLS.ios}
        target="_blank"
        rel="noopener"
      >
        <img
          src={appStoreBadgeUrl}
          alt={t("pages.downloadAndInstall.ios.install")}
        />
      </a>
    </section>

    <section class="platform store-card">
      <div class="platform-header">
        <span class="platform-icon" aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
            <path d="M12 18h.01"></path>
          </svg>
        </span>
        <h2>{t("pages.downloadAndInstall.android.title")}</h2>
      </div>
      <p class="instruction-header">
        {t("pages.downloadAndInstall.android.description")}
      </p>
      <a
        class="store-badge"
        href={MOBILE_APP_STORE_URLS.android}
        target="_blank"
        rel="noopener"
      >
        <img
          src={googlePlayBadgeUrl}
          alt={t("pages.downloadAndInstall.android.install")}
        />
      </a>
    </section>
  </div>

  <section class="platform">
    <div class="platform-header">
      <span class="platform-icon" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.28 2.55a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45L4 16"
          ></path>
        </svg>
      </span>
      <h2>{t("pages.downloadAndInstall.desktop.title")}</h2>
    </div>
    <p class="instruction-header">
      {t("pages.downloadAndInstall.desktop.description")}
    </p>

    <div class="recommended">
      {
        DESKTOP_PLATFORMS.map((platform) => (
          <a
            class="recommended-link"
            data-desktop-platform={platform}
            href={getDesktopDownloadUrl(
              DESKTOP_RECOMMENDED_DOWNLOADS[platform].file,
            )}
            hidden
          >
            <DesktopPlatformIcon platform={platform} />
            {t(DESKTOP_PLATFORM_BUTTON_LABEL_KEYS[platform])}
          </a>
        ))
      }
    </div>

    <h3 class="all-downloads">
      {t("pages.downloadAndInstall.desktop.allDownloads")}
    </h3>
    <div class="platform-cards">
      {
        DESKTOP_PLATFORMS.map((platform) => (
          <div class="platform-card">
            <h4>
              <DesktopPlatformIcon platform={platform} />
              {t(DESKTOP_PLATFORM_LABEL_KEYS[platform])}
            </h4>
            <ul>
              {DESKTOP_DOWNLOADS[platform].map((download) => (
                <li>
                  <a href={getDesktopDownloadUrl(download.file)}>
                    {t(download.labelKey)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="other">
    <h2>{t("pages.downloadAndInstall.other")}</h2>

    <div class="other-card">
      <h3>{t("pages.downloadAndInstall.extension")}</h3>
      <p>{t("pages.downloadAndInstall.extension.description")}</p>
      <p class="store-links">
        <a
          class="store-link"
          href="https://addons.mozilla.org/firefox/addon/recipesage/"
          target="_blank"
          rel="noopener">{t("pages.downloadAndInstall.extension.installFirefox")}</a
        >
        <a
          class="store-link"
          href="https://chromewebstore.google.com/detail/oepplnnfceidfaaacjpdpobnjkcpgcpo"
          target="_blank"
          rel="noopener">{t("pages.downloadAndInstall.extension.installChrome")}</a
        >
      </p>
    </div>

    <div class="other-card">
      <h3>{t("pages.downloadAndInstall.bookmark")}</h3>
      <p>{t("pages.downloadAndInstall.bookmark.description")}</p>
      <p>
        <a
          class="bookmarklet"
          href={bookmarklet}
          onclick="return false"
          title={t("pages.downloadAndInstall.bookmark.linkTitle")}
          >{t("pages.downloadAndInstall.bookmark.instructions")}</a
        >
      </p>
      <p>{t("pages.downloadAndInstall.bookmark.usage")}</p>
    </div>
  </section>

  <p class="store-trademarks">
    {t("pages.downloadAndInstall.storeTrademarks")}
  </p>
</article>

<script>
  import { detectDesktopPlatform } from "../../../util/shared/src/desktopDownloads";

  const platform = detectDesktopPlatform(navigator.userAgent);
  if (platform) {
    const recommended = document.querySelector(
      `[data-desktop-platform="${platform}"]`,
    );
    if (recommended instanceof HTMLElement) recommended.hidden = false;
  }
</script>

<style>
  .download-hero {
    position: relative;
    isolation: isolate;
    color: var(--hero-text);
    overflow: hidden;
    padding: 140px 24px 60px;
  }

  .download-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: -1;
  }

  @media (max-width: 800px) {
    .download-hero {
      padding: 50px 24px 50px;
    }
  }

  .download-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.7) 0%, transparent 180px),
      var(--hero-overlay);
  }

  .download-hero-inner {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
  }

  .download-hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0 0 12px;
    font-weight: 600;
  }

  .lead {
    font-size: 1.15rem;
    margin: 0;
    opacity: 0.95;
  }

  .download-content {
    max-width: 760px;
    margin: 0 auto;
    padding: 40px 24px 0;
    line-height: 1.65;
  }

  .store-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-bottom: 20px;
  }

  .store-badge {
    align-self: flex-start;
    margin-top: auto;
  }

  .store-badge img {
    display: block;
    height: 48px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .platform {
    background: var(--surface);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 20px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
  }

  .store-card {
    display: flex;
    flex-direction: column;
    margin-bottom: 0;
  }

  .platform-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .platform-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
    flex-shrink: 0;
  }

  .platform h2 {
    margin: 0;
    font-size: 1.3rem;
  }

  .instruction-header {
    color: var(--text-muted);
    margin: 0 0 12px;
  }

  .store-card .instruction-header {
    margin-bottom: 18px;
  }

  .recommended-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    border-radius: 8px;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    text-decoration: none;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .recommended-link[hidden] {
    display: none;
  }

  .recommended-link:hover {
    filter: brightness(1.08);
  }

  .all-downloads {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-muted);
    margin: 28px 0 12px;
  }

  .platform-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 16px;
  }

  .platform-card {
    background: var(--bg);
    border-radius: 8px;
    padding: 16px;
  }

  .platform-card h4 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 10px;
    font-size: 1rem;
  }

  .platform-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .platform-card li + li {
    margin-top: 8px;
  }

  .platform-card a {
    color: var(--accent-text);
  }

  .other {
    margin-top: 40px;
  }

  .other > h2 {
    font-size: 1.4rem;
    margin: 0 0 16px;
  }

  .other-card {
    background: var(--surface);
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 16px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
  }

  .other-card h3 {
    margin: 0 0 8px;
    font-size: 1.1rem;
  }

  .other-card p {
    color: var(--text-muted);
    margin: 0 0 8px;
  }

  .store-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .store-link {
    color: var(--accent-text);
    text-shadow: none;
  }

  .bookmarklet {
    color: var(--accent-text);
    cursor: grab;
  }

  .store-trademarks {
    color: var(--text-muted);
    font-size: 0.8rem;
    margin: 24px 0 0;
  }
</style>
