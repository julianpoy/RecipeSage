{
  "rules": {
    "keysOnViews": "error",
    "zombieKeys": "warning",
    "misprint": "warning",
    "maxWarning": "0",
    "misprintCoefficient": "0.9",
    "ignoredKeys": [
      "generic.menu",
      "generic.loading",
      "generic.previous",
      "generic.next",
      "components.cookingToolbar.clearLabel",
      "components.multiImageUpload.remove",
      "components.multiImageUpload.moveEarlier",
      "components.multiImageUpload.moveLater",
      "components.colorPicker.noColor",
      "generic.share",
      "generic.copy",
      "generic.reorder",
      "pages.mealPlanMealOrderModal.chooseColor",
      "pages.home.search.clear"
    ],
    "ignoredMisprintKeys": [],
    "ast": {
      "isNgsTranslateImported": "error"
    }
  },
  "tsconfig": "./tsconfig.json",
  "project": "./src/app/**/*.{html,ts}",
  "languages": "./src/assets/i18n/en-us.json"
}
