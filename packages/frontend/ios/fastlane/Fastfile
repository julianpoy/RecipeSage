default_platform(:ios)

def build_version_name
  tag = ENV["CIRCLE_TAG"]
  return tag.sub(/^v/, "") if tag && !tag.strip.empty?
  "0.0.0-dev"
end

def release_version_name
  tag = ENV["CIRCLE_TAG"]
  return tag.sub(/^v/, "") if tag && !tag.strip.empty?
  "0.0.1"
end

def resolved_build_number
  build_num = ENV["CIRCLE_BUILD_NUM"]
  return build_num if build_num && !build_num.strip.empty?
  Time.now.to_i.to_s
end

platform :ios do
  private_lane :build_ipa do |options|
    build_app(
      project: "App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "App.ipa",
      xcargs: [
        "MARKETING_VERSION='#{options[:version_name]}'",
        "CURRENT_PROJECT_VERSION='#{resolved_build_number}'",
      ].join(" "),
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: ENV["IOS_TEAM_ID"],
        provisioningProfiles: {
          "com.recipesage.ios" => ENV["IOS_PROVISIONING_PROFILE_NAME"],
          "com.recipesage.ios.ShareExtension" => ENV["IOS_SHARE_EXT_PROVISIONING_PROFILE_NAME"],
        },
      },
    )
    lane_context[SharedValues::IPA_OUTPUT_PATH]
  end

  desc "Build the signed IPA without uploading"
  lane :build do
    ipa = build_ipa(version_name: build_version_name)
    UI.success("Built #{ipa}")
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    %w[APPLE_API_KEY_ID APPLE_API_ISSUER APPLE_API_KEY_PATH IOS_TEAM_ID IOS_PROVISIONING_PROFILE_NAME IOS_SHARE_EXT_PROVISIONING_PROFILE_NAME].each do |key|
      value = ENV[key]
      UI.user_error!("#{key} is required for the TestFlight upload") if value.nil? || value.strip.empty?
    end

    ipa = build_ipa(version_name: release_version_name)
    api_key = app_store_connect_api_key(
      key_id: ENV["APPLE_API_KEY_ID"],
      issuer_id: ENV["APPLE_API_ISSUER"],
      key_filepath: ENV["APPLE_API_KEY_PATH"],
    )
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end
end
